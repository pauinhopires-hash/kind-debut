# Variaveis de ambiente — APENAS NOMES, sem valores reais.
# Copie para .env e preencha com os valores do seu proprio projeto de backend.

# Identificador do projeto de backend (Supabase)
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# URL publica da API do backend
SUPABASE_URL=
VITE_SUPABASE_URL=

# Chave publicavel (anon/publishable) — pode ir para o navegador
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# NAO INCLUIDAS NESTE PACOTE (secretas, nao acessiveis pela plataforma Lovable):
#   SUPABASE_SERVICE_ROLE_KEY  -> chave administrativa do backend
#   DATABASE_PASSWORD          -> senha do banco
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY -> chaves de notificacao push, se usadas
# ----------------------------------------------------------------------------

# Somente em host Node autonomo (Cloud Run / App Hosting):
# K_SERVICE=
# PORT=
